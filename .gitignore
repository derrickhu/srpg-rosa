node_modules/
.DS_Store
godot/.godot/
tools/godot/
wechat-godot/engine/*.bin
wechat-godot/engine/*.wasm*
wechat-godot/engine/godot*
wechat-godot/subpack1/

# CDN 上传脚本临时文件与密钥
scripts/.cdn_manifest.json
scripts/.cdn_manifest.cloudbase.json
scripts/cdn_manifest_for_upload.json
scripts/.cdn_secret

# Godot 字体源（仅本地子集用，子集与 godot-cdn/ 入库）
godot/art/fonts/SourceHanSansSC-Medium.otf
godot/art/fonts/SourceHanSansSC-Bold.otf

# generate2dsprite 的审片产物：由 raw-sheet.png 可重新生成，不入库。
# 逐帧 PNG、pipeline-meta.json、scale-profile.json、raw-sheet.png 是 sprite2anim 的
# 构建输入，必须入库。
art/sprite-runs/**/raw-sheet-clean.png
art/sprite-runs/**/sheet-transparent.png
art/sprite-runs/**/*-strip.png
art/sprite-runs/**/*.gif

# vfx-sheet.py 的审片长条同理；逐帧 PNG、pipeline-meta.json、raw-sheet.png 入库。
art/vfx-runs/**/*-strip.png

# 生图落盘到 Cursor 的 assets 目录，切帧前先拷到这里当暂存。
# 同一张图会以 raw-sheet.png 留在 art/vfx-runs/<id>/ 里，这份是重复的。
.tmp-gen/

# 背景、地形、UI 的试做与审片合成图。母版在 prompt 里可复现，成品已进 images/，不入库。
.pilot/
